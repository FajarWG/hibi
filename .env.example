# Salin ke .env lalu isi nilainya. Jangan commit .env.

# PostgreSQL. Hibi memakai database yang sama dengan Nihongo Flow;
# tabelnya dibedakan dengan prefix hibi_ sehingga keduanya bisa hidup berdampingan.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Rahasia untuk menandatangani JWT sesi. Bangkitkan yang acak dan panjang:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""

# Opsional. Kalau kosong, fitur AI mati tapi seluruh fitur inti tetap jalan:
# review SRS, sesi tulis Kakou tingkat 2 dan 3, kuis kanji, library, timer.
GEMINI_API_KEY=""
